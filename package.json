{
  "name": "dia-chi-moi",
  "version": "1.0.0",
  "description": "Chuyển địa chỉ Việt Nam cũ (63 tỉnh, 3 cấp) sang địa chỉ mới sau sáp nhập 2025 (34 tỉnh, 2 cấp): thư viện, CLI, MCP server và agent skill. Offline, không phụ thuộc.",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    },
    "./mcp": "./src/mcp.mjs",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "bin": {
    "dia-chi-moi": "bin/dia-chi-moi.mjs",
    "diachimoi": "bin/dia-chi-moi.mjs",
    "dia-chi-moi-mcp": "bin/dia-chi-moi-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "data/diachimoi.json",
    "index.d.ts",
    "skills",
    ".claude-plugin",
    "README.md",
    "README.en.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build:data": "node scripts/build-data.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vietnam",
